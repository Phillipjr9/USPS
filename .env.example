# Postgres connection string.
#
# On Vercel this is injected automatically when the Neon database is connected
# to the project (Neon → Vercel integration, or Storage → Neon in the project
# dashboard). The exact variable name depends on how it was added; the API
# accepts DATABASE_URL, POSTGRES_URL, NEON_DATABASE_URL, DATABASE_URL_UNPOOLED
# or POSTGRES_PRISMA_URL.
#
# For local development copy this file to .env.local and run `npx vercel dev`
# so the /api routes are served alongside the Vite app.
DATABASE_URL=postgresql://user:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
